# Playwright tests configuration template
# Copy to .env and adjust for your environment.

# Base URL of the app under test (the mock server in dev)
BASE_URL=http://localhost:3000

# Optional: comma-separated list of Playwright devices to run,
# e.g. "Desktop Chrome,Desktop Firefox,Desktop Safari". Defaults to Desktop Chrome.
# BROWSERS=Desktop Chrome

# CI mode (set by GitHub Actions; do not override locally unless needed)
# CI=false